# Copy to .env and fill in. Never commit .env.
DADIP_ENV=development
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"  (required in production)
DADIP_JWT_SECRET=
DADIP_DATABASE_URL=postgresql+psycopg://dadip:dadip@localhost:5432/dadip
DADIP_REDIS_URL=redis://localhost:6379/0
DADIP_MQTT_HOST=localhost
DADIP_MQTT_PORT=1883
DADIP_CORS_ORIGINS=["http://localhost:3000"]

# Optional real channel. Without these, Telegram stays disabled and only mock channels are used.
DADIP_TELEGRAM_BOT_TOKEN=
DADIP_TELEGRAM_DEFAULT_CHAT_ID=
DADIP_WEBHOOK_URL=

# Optional LLM for AURA chat summaries (never used for scoring).
DADIP_GROQ_API_KEY=

# Client IP behind the Next.js proxy: set the same secret here and in the frontend's DADIP_PROXY_SECRET
# (or list fixed proxy addresses in DADIP_TRUSTED_PROXIES). Without it, rate limits apply per proxy, not per citizen.
DADIP_PROXY_SHARED_SECRET=
DADIP_TRUSTED_PROXIES=[]

# --- Frontend (frontend/.env.local) ---
# DADIP_API_URL=http://localhost:8000
# DADIP_PROXY_SECRET=<same value as DADIP_PROXY_SHARED_SECRET>

# Used once by `python -m dadip.seed --admin-email ...`
DADIP_SEED_ADMIN_PASSWORD=
POSTGRES_PASSWORD=dadip
